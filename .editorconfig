root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,json5,toml,mcmeta}]
indent_size = 2

[*.mcfunction]
# One command per line, however long; the game has no line continuation we use.
max_line_length = off

[*.md]
trim_trailing_whitespace = false
# List continuation and nested content follow Markdown, not code, indentation.
indent_size = unset

[Makefile]
indent_style = tab
